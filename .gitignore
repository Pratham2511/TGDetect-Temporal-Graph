# ==============================================================================
# TGDetect Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Backend
# ------------------------------------------------------------------------------
backend/.venv/
.venv/
venv/
ENV/
env/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib64/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# Backend Raw Data (keep demo processed datasets, ignore huge raw downloads)
backend/data/raw/
data/raw/

# ------------------------------------------------------------------------------
# Node & Frontend (Next.js)
# ------------------------------------------------------------------------------
frontend/node_modules/
node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
.next/
out/

# TypeScript
*.tsbuildinfo
frontend/next-env.d.ts
next-env.d.ts

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!frontend/.env.example

# ------------------------------------------------------------------------------
# Logs & Process Outputs
# ------------------------------------------------------------------------------
*.log
frontend/*.log
backend/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev.log
server.log

# ------------------------------------------------------------------------------
# Editor & OS Artifacts
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Workspace & Local Tooling Artifacts
# ------------------------------------------------------------------------------
.agents/
AGENTS.md
CLAUDE.md
.claude/
.vercel/
/download/
/upload/
/tool-results/
.continue/
.qmind/
.directory
docs/baseline_audit/
backend/data/fixtures/
backend/data/processed/test_e2e_simulation/
backend/data/uploads/
